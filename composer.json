{
    "name": "hexatex/laravel-image",
    "description": "Adds the ability to store and manage images.",
    "license": "MIT",
    "authors": [
        {
            "name": "Cory Baumer",
            "email": "cory.j.baumer@gmail.com",
            "homepage": "https://github.com/hexatex"
        }
    ],
    "homepage": "https://github.com/hexatex/laravel-image",
    "keywords": [
        "Laravel",
        "LaravelImage"
    ],
    "require": {
        "illuminate/support": "~9",
        "intervention/image": "^2.7",
        "laravel/passport": "^11.9",
        "spatie/laravel-permission": "^5.11"
    },
    "require-dev": {
        "phpunit/phpunit": "~9.0",
        "orchestra/testbench": "^7.30",
        "nunomaduro/collision": "^6.2",
        "brianium/paratest": "^6.10"
    },
    "autoload": {
        "psr-4": {
            "Hexatex\\LaravelImage\\": "src/",
            "Hexatex\\LaravelService\\": "../laravel-service/src/",
            "Hexatex\\PhpMisc\\": "../php-misc/src/",
            "Hexatex\\LaravelUser\\": "../laravel-user/src/",
            "Hexatex\\LaravelFiltered\\": "../laravel-filtered/src/",
            "Hexatex\\LaravelValidation\\": "../laravel-validation/src/",
            "Hexatex\\LaravelMisc\\": "../laravel-misc/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hexatex\\LaravelImage\\Tests\\": "tests",
            "Hexatex\\LaravelImage\\Factories\\": "database/factories/",
            "Hexatex\\LaravelUser\\Factories\\": "../laravel-user/database/factories/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hexatex\\LaravelImage\\LaravelImageServiceProvider"
            ],
            "aliases": {
            }
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "@build",
            "@php vendor/bin/testbench serve"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ]
    }
}
